# Local Development Environment Variables
# Source this file before running the dashboard locally:
#   source .env.dev
#   mix phx.server

# WAMP Configuration - Connect to cluster Bondy instance
export BONDY_URL="ws://localhost:30080/ws"
export BONDY_REALM="be.cortexiq.energy"
export BONDY_ADMIN_URL="http://localhost:30082"

# Database Configuration - Connect to cluster PostgreSQL
# (Optional - you can also run a local PostgreSQL instance)
# Note: You'll need to port-forward the PostgreSQL service:
#   kubectl --context kind-macula-hub port-forward -n macula-hub svc/postgres 5432:5432
export DATABASE_URL="ecto://cortexiq:cortexiq123@localhost:5432/cortexiq_dashboard"

# Phoenix Configuration
export PHX_HOST="localhost"
export PHX_PORT="4000"
export SECRET_KEY_BASE="dev_secret_key_base_that_needs_to_be_at_least_64_characters_long_for_phoenix"

# Simulation Configuration (optional - defaults are set)
# export SIMULATION_SPEED="105120"
# export SIMULATION_START_DATE="2025-01-01T00:00:00Z"
