# syntax=docker/dockerfile:1.4
####################################################################################################
# CortexIQ Dashboard Hub
# Includes: Bondy WAMP Router + Dashboard (with MaculaOs in hub mode)
#
# This container runs:
# - Bondy WAMP router (realm hub)
# - CortexIQ Dashboard (analytics + web UI)
# - PostgreSQL client (connects to external PostgreSQL)
####################################################################################################

ARG ELIXIR_VERSION=1.18.1
ARG OTP_VERSION=27.2
ARG ALPINE_VERSION=3.21.0
ARG NODE_VERSION=20

####################################################################################################
# Stage 1: Builder
####################################################################################################
FROM hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-alpine-${ALPINE_VERSION} AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    build-base \
    nodejs \
    npm

WORKDIR /app

# Set build environment
ENV MIX_ENV=prod

# Install Hex and Rebar
RUN mix local.hex --force && \
    mix local.rebar --force

# Copy umbrella root
COPY system/cortex_iq_dashboard_umbrella/mix.exs system/cortex_iq_dashboard_umbrella/mix.lock ./
COPY system/cortex_iq_dashboard_umbrella/config ./config

# Copy standalone dependencies to match umbrella app paths
# Apps at /app/apps/cortex_iq_dashboard/ have these dependencies:
#   - path: "../../../cortex_iq_core" → /app/apps/cortex_iq_dashboard/../../../cortex_iq_core → needs /cortex_iq_core
#   - path: "../../../cortex_iq_dashboard_schemas" → /app/apps/cortex_iq_dashboard/../../../cortex_iq_dashboard_schemas → needs /cortex_iq_dashboard_schemas
#   - path: "../../../macula_sdk" → /app/apps/cortex_iq_dashboard/../../../macula_sdk → needs /macula_sdk
COPY system/cortex_iq_core /cortex_iq_core
COPY system/cortex_iq_dashboard_schemas /cortex_iq_dashboard_schemas
COPY system/macula_sdk /macula_sdk

# Copy umbrella apps mix files
COPY system/cortex_iq_dashboard_umbrella/apps/cortex_iq_dashboard/mix.exs ./apps/cortex_iq_dashboard/
COPY system/cortex_iq_dashboard_umbrella/apps/cortex_iq_dashboard_web/mix.exs ./apps/cortex_iq_dashboard_web/

# Get dependencies
# Configure git to use SSH
RUN mkdir -p -m 0700 ~/.ssh && ssh-keyscan github.com >> ~/.ssh/known_hosts

# Get dependencies (uses SSH secret for private GitHub repos)
RUN --mount=type=ssh mix deps.get --only prod
RUN mix deps.compile

# Copy application source code (with cache busting)
ARG CACHE_BUST=default
RUN echo "Cache bust: $CACHE_BUST"
COPY system/cortex_iq_dashboard_umbrella/apps ./apps

# Install and build frontend assets
WORKDIR /app/apps/cortex_iq_dashboard_web/assets
RUN npm ci --only=production

WORKDIR /app

# Compile Elixir code
RUN mix compile

# Build frontend assets
RUN mix assets.deploy

# Build release
RUN mix release cortex_iq_dashboard

####################################################################################################
# Stage 2: Runtime
####################################################################################################
FROM alpine:${ALPINE_VERSION} AS runtime

# Install runtime dependencies
RUN apk add --no-cache \
    openssl \
    ncurses-libs \
    libstdc++ \
    libgcc \
    postgresql-client

# Create non-root user
RUN addgroup -g 1000 cortexiq && \
    adduser -D -u 1000 -G cortexiq cortexiq

WORKDIR /app

# Copy release from builder
COPY --from=builder --chown=cortexiq:cortexiq /app/_build/prod/rel/cortex_iq_dashboard ./

USER cortexiq

# Runtime environment
ENV HOME=/app
ENV LANG=C.UTF-8
ENV MIX_ENV=prod

# Default environment variables (overrideable)
ENV PORT=4000
ENV MACULA_MODE=realm_hub
ENV MACULA_REALM=be.cortexiq.energy
ENV BONDY_URL=http://bondy:18080

# Database configuration
ENV DATABASE_URL=postgresql://postgres:postgres@db:5432/cortex_iq_dashboard_prod

# Expose Phoenix HTTP port
EXPOSE 4000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD ["/app/bin/cortex_iq_dashboard", "rpc", "1 + 1"]

ENTRYPOINT ["/app/bin/cortex_iq_dashboard"]
CMD ["start"]
