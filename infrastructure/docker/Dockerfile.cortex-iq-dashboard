# Dashboard payload for Macula hub
# Includes both cortex_iq_dashboard and cortex_iq_dashboard_web
FROM macula/os-base:latest

# Install Node.js for Phoenix assets
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Copy dashboard apps
COPY system/apps/cortex_iq_dashboard ./apps/cortex_iq_dashboard
COPY system/apps/cortex_iq_dashboard_web ./apps/cortex_iq_dashboard_web

# Compile dashboard apps
WORKDIR /app
RUN mix deps.get && \
    mix compile

# Compile assets for dashboard_web
WORKDIR /app/apps/cortex_iq_dashboard_web/assets
RUN npm install && \
    npm run deploy

WORKDIR /app
RUN mix phx.digest

# Environment variables
ENV MACULA_MODE=realm_hub
ENV REALM_URI=be.cortexiq.energy
ENV BONDY_WS_URL=ws://localhost:18080/ws
ENV DATABASE_URL=ecto://cortexiq:cortexiq123@localhost/cortexiq_dashboard
ENV PHX_HOST=192.168.100.10
ENV PHX_PORT=4000
ENV SECRET_KEY_BASE=CHANGE_ME_IN_PRODUCTION

# Expose Phoenix port
EXPOSE 4000

# Run migrations and start Phoenix
CMD mix ecto.create && \
    mix ecto.migrate && \
    mix phx.server
