# Base image for MaculaOs runtime
# This provides the Elixir environment and MaculaOs platform code

FROM hexpm/elixir:1.17.3-erlang-27.1.2-ubuntu-jammy-20240808 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy umbrella structure
COPY system/mix.exs system/mix.lock ./
COPY system/config ./config

# Copy MaculaOs and core apps (not payloads yet)
COPY system/apps/macula_os ./apps/macula_os
COPY system/apps/cortex_iq_core ./apps/cortex_iq_core

# Get dependencies
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get

# Compile MaculaOs platform
ENV MIX_ENV=prod
RUN mix deps.compile && \
    mix compile

# Runtime stage
FROM hexpm/elixir:1.17.3-erlang-27.1.2-ubuntu-jammy-20240808

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    openssl \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled code from builder
WORKDIR /app
COPY --from=builder /app/_build/prod /app/_build/prod
COPY --from=builder /app/deps /app/deps
COPY --from=builder /app/apps /app/apps
COPY --from=builder /app/config /app/config
COPY --from=builder /app/mix.exs /app/mix.lock /app/

# Set environment
ENV MIX_ENV=prod
ENV LANG=C.UTF-8

# This base image doesn't run anything - payloads will extend it
CMD ["/bin/bash"]
