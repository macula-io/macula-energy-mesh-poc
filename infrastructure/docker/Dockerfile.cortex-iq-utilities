# Provider bots payload for Macula edge nodes
FROM macula/os-base:latest

# Copy utilities payload
COPY system/apps/cortex_iq_utilities ./apps/cortex_iq_utilities

# Compile utilities app
WORKDIR /app
RUN mix deps.get && \
    mix compile

# Environment variables (overridable at runtime)
ENV MACULA_MODE=edge
ENV REALM_URI=be.cortexiq.energy
ENV BONDY_WS_URL=ws://192.168.100.10:18080/ws
ENV NUM_PROVIDERS=5

# Run the utilities application
CMD ["mix", "run", "--no-halt", "-e", "CortexIqUtilities.Application.start(:normal, [])"]
