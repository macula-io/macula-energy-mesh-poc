#!/bin/bash
set -euo pipefail

# macula-ctl - Macula Infrastructure Management CLI
# Wraps bootstrap scripts and provides Macula-specific status checks

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/scripts"
SSH_KEY="$HOME/.ssh/macula_rsa"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# VM IPs
HUB_IP="192.168.100.10"
declare -A EDGE_IPS=(
  [edge-01]="192.168.100.11"
  [edge-02]="192.168.100.12"
  [edge-03]="192.168.100.13"
  [edge-04]="192.168.100.14"
)

log_info() {
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
  echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1"
}

log_success() {
  echo -e "${GREEN}✓${NC} $1"
}

log_fail() {
  echo -e "${RED}✗${NC} $1"
}

# ============================================================================
# COMMANDS
# ============================================================================

cmd_bootstrap() {
  log_info "Bootstrapping Macula infrastructure..."
  "$SCRIPTS_DIR/bootstrap.sh"
}

cmd_provision() {
  if [[ $# -lt 1 ]]; then
    log_error "Usage: macula-ctl provision <hub|edge-01|edge-02|edge-03|edge-04|all>"
    exit 1
  fi

  case $1 in
    hub)
      "$SCRIPTS_DIR/provision-hub.sh"
      ;;
    edge-*)
      "$SCRIPTS_DIR/provision-edge.sh" "$1"
      ;;
    all)
      "$SCRIPTS_DIR/provision-hub.sh"
      for edge in edge-01 edge-02 edge-03 edge-04; do
        "$SCRIPTS_DIR/provision-edge.sh" "$edge"
      done
      ;;
    *)
      log_error "Invalid target: $1"
      exit 1
      ;;
  esac
}

cmd_status() {
  echo -e "${PURPLE}=== Macula Infrastructure Status ===${NC}\n"

  # VMs
  echo -e "${CYAN}VMs:${NC}"
  for vm in macula-hub-01 macula-edge-01 macula-edge-02 macula-edge-03 macula-edge-04; do
    status=$(virsh domstate "$vm" 2>/dev/null || echo "not found")
    if [[ "$status" == "running" ]]; then
      log_success "$vm: $status"
    else
      log_fail "$vm: $status"
    fi
  done
  echo ""

  # Hub WAMP connectivity
  echo -e "${CYAN}Hub WAMP Router:${NC}"
  if curl -s -m 2 "http://$HUB_IP:18081" > /dev/null 2>&1; then
    log_success "Bondy HTTP API reachable at $HUB_IP:18081"
  else
    log_fail "Bondy HTTP API not reachable"
  fi
  echo ""

  # Edge K3d clusters
  echo -e "${CYAN}Edge Clusters:${NC}"
  for edge in "${!EDGE_IPS[@]}"; do
    ip="${EDGE_IPS[$edge]}"
    if ssh -i "$SSH_KEY" -o ConnectTimeout=2 -o StrictHostKeyChecking=no ubuntu@"$ip" "k3d cluster list | grep -q macula-edge" 2>/dev/null; then
      log_success "$edge: K3d cluster running"
    else
      log_fail "$edge: K3d cluster not running"
    fi
  done
  echo ""

  # FluxCD
  echo -e "${CYAN}FluxCD Deployments:${NC}"
  for edge in "${!EDGE_IPS[@]}"; do
    ip="${EDGE_IPS[$edge]}"
    if ssh -i "$SSH_KEY" -o ConnectTimeout=2 -o StrictHostKeyChecking=no ubuntu@"$ip" "kubectl get pods -n flux-system 2>/dev/null | grep -q Running" 2>/dev/null; then
      log_success "$edge: FluxCD running"
    else
      log_fail "$edge: FluxCD not running"
    fi
  done
}

cmd_ssh() {
  if [[ $# -lt 1 ]]; then
    log_error "Usage: macula-ctl ssh <hub|edge-01|edge-02|edge-03|edge-04>"
    exit 1
  fi

  case $1 in
    hub)
      ssh -i "$SSH_KEY" ubuntu@"$HUB_IP"
      ;;
    edge-*)
      ip="${EDGE_IPS[$1]}"
      ssh -i "$SSH_KEY" ubuntu@"$ip"
      ;;
    *)
      log_error "Invalid target: $1"
      exit 1
      ;;
  esac
}

cmd_logs() {
  if [[ $# -lt 1 ]]; then
    log_error "Usage: macula-ctl logs <hub|edge-01|edge-02|edge-03|edge-04> [service]"
    exit 1
  fi

  target=$1
  service=${2:-""}

  case $target in
    hub)
      if [[ -z "$service" ]]; then
        log_info "Available services: bondy, macula-os"
        exit 0
      fi
      ssh -i "$SSH_KEY" ubuntu@"$HUB_IP" "sudo journalctl -u $service -f"
      ;;
    edge-*)
      ip="${EDGE_IPS[$target]}"
      if [[ -z "$service" ]]; then
        log_info "Showing all pods in macula-system namespace"
        ssh -i "$SSH_KEY" ubuntu@"$ip" "kubectl logs -n macula-system --all-containers -f --tail=50"
      else
        ssh -i "$SSH_KEY" ubuntu@"$ip" "kubectl logs -n macula-system -l app=$service -f"
      fi
      ;;
    *)
      log_error "Invalid target: $target"
      exit 1
      ;;
  esac
}

cmd_destroy() {
  log_warn "This will destroy all VMs and networks. Are you sure? (y/N)"
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    log_info "Aborted"
    exit 0
  fi

  log_info "Destroying VMs..."
  for vm in macula-hub-01 macula-edge-01 macula-edge-02 macula-edge-03 macula-edge-04; do
    virsh destroy "$vm" 2>/dev/null || true
    virsh undefine "$vm" --remove-all-storage 2>/dev/null || true
  done

  log_info "Destroying network..."
  virsh net-destroy macula-net 2>/dev/null || true
  virsh net-undefine macula-net 2>/dev/null || true

  log_success "Infrastructure destroyed"
}

cmd_vms() {
  log_info "Use standard tools for VM management:"
  echo ""
  echo "  virt-top              # Real-time VM monitoring (like top)"
  echo "  virsh list --all      # List all VMs"
  echo "  virsh dominfo <vm>    # VM details"
  echo "  virsh start <vm>      # Start a VM"
  echo "  virsh shutdown <vm>   # Shutdown a VM"
  echo "  virt-manager          # GUI manager (if installed)"
  echo ""
  echo "Macula VMs:"
  virsh list --all | grep macula || echo "No Macula VMs found"
}

cmd_flux() {
  if [[ $# -lt 2 ]]; then
    log_error "Usage: macula-ctl flux <edge-01|edge-02|edge-03|edge-04> <status|reconcile|suspend|resume>"
    exit 1
  fi

  edge=$1
  action=$2
  ip="${EDGE_IPS[$edge]}"

  case $action in
    status)
      ssh -i "$SSH_KEY" ubuntu@"$ip" "flux get all"
      ;;
    reconcile)
      ssh -i "$SSH_KEY" ubuntu@"$ip" "flux reconcile kustomization flux-system --with-source"
      ;;
    suspend)
      ssh -i "$SSH_KEY" ubuntu@"$ip" "flux suspend kustomization flux-system"
      ;;
    resume)
      ssh -i "$SSH_KEY" ubuntu@"$ip" "flux resume kustomization flux-system"
      ;;
    *)
      log_error "Invalid action: $action"
      exit 1
      ;;
  esac
}

cmd_dashboard() {
  log_info "Opening dashboard at http://$HUB_IP:4000"
  xdg-open "http://$HUB_IP:4000" 2>/dev/null || open "http://$HUB_IP:4000" 2>/dev/null || log_info "Please open http://$HUB_IP:4000 in your browser"
}

cmd_help() {
  cat <<EOF
macula-ctl - Macula Infrastructure Management

Usage: macula-ctl <command> [args]

Infrastructure Commands:
  bootstrap                      Create VMs and network
  provision <target>             Provision hub, edge-NN, or all
  status                         Show infrastructure status
  destroy                        Destroy all VMs and networks

Access Commands:
  ssh <target>                   SSH into hub or edge-NN
  logs <target> [service]        Tail logs from target
  dashboard                      Open Phoenix dashboard in browser

VM Management:
  vms                            Show VM management commands

FluxCD Commands:
  flux <edge> status             Show FluxCD status
  flux <edge> reconcile          Force reconcile
  flux <edge> suspend            Suspend GitOps
  flux <edge> resume             Resume GitOps

Examples:
  macula-ctl bootstrap           # Create infrastructure
  macula-ctl provision all       # Provision hub + all edges
  macula-ctl status              # Check everything
  macula-ctl ssh hub             # SSH to hub
  macula-ctl logs edge-01        # Tail edge-01 logs
  macula-ctl flux edge-01 status # Check FluxCD on edge-01
  macula-ctl dashboard           # Open UI

For VM monitoring, use: virt-top
EOF
}

# ============================================================================
# MAIN
# ============================================================================

main() {
  if [[ $# -eq 0 ]]; then
    cmd_help
    exit 0
  fi

  cmd=$1
  shift

  case $cmd in
    bootstrap)
      cmd_bootstrap "$@"
      ;;
    provision)
      cmd_provision "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    ssh)
      cmd_ssh "$@"
      ;;
    logs)
      cmd_logs "$@"
      ;;
    destroy)
      cmd_destroy "$@"
      ;;
    vms)
      cmd_vms "$@"
      ;;
    flux)
      cmd_flux "$@"
      ;;
    dashboard)
      cmd_dashboard "$@"
      ;;
    help|--help|-h)
      cmd_help
      ;;
    *)
      log_error "Unknown command: $cmd"
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
