# Dockerfile for mesh_edge applications (homes and utilities)
# Multi-stage build for optimal image size

# Stage 1: Build
FROM hexpm/elixir:1.18.1-erlang-27.2.1-alpine-3.21.3 AS build

# Install build dependencies
RUN apk add --no-cache build-base git

# Set working directory
WORKDIR /app

# Install hex and rebar
RUN mix local.hex --force && \
    mix local.rebar --force

# Set build environment
ENV MIX_ENV=prod

# Copy mix files
COPY system/mix.exs system/mix.lock ./
COPY system/config config

# Copy all app mix files
COPY system/apps/mesh_core/mix.exs ./apps/mesh_core/
COPY system/apps/mesh_wamp/mix.exs ./apps/mesh_wamp/
COPY system/apps/mesh_edge/mix.exs ./apps/mesh_edge/
COPY system/apps/mesh_edge_homes/mix.exs ./apps/mesh_edge_homes/
COPY system/apps/mesh_edge_utilities/mix.exs ./apps/mesh_edge_utilities/

# Get dependencies
RUN mix deps.get --only prod
RUN mix deps.compile

# Copy application code
COPY system/apps/mesh_core ./apps/mesh_core
COPY system/apps/mesh_wamp ./apps/mesh_wamp
COPY system/apps/mesh_edge ./apps/mesh_edge
COPY system/apps/mesh_edge_homes ./apps/mesh_edge_homes
COPY system/apps/mesh_edge_utilities ./apps/mesh_edge_utilities

# Compile the project
RUN mix compile

# Build releases
RUN mix release mesh_edge_homes
RUN mix release mesh_edge_utilities

# Stage 2: Runtime (homes)
FROM alpine:3.21.3 AS mesh_edge_homes

RUN apk add --no-cache libstdc++ openssl ncurses-libs

WORKDIR /app

# Copy the release from build stage
COPY --from=build /app/_build/prod/rel/mesh_edge_homes ./

# Set environment
ENV HOME=/app
ENV MIX_ENV=prod

# Run as non-root user
RUN addgroup -S app && adduser -S app -G app
USER app

CMD ["/app/bin/mesh_edge_homes", "start"]

# Stage 3: Runtime (utilities)
FROM alpine:3.21.3 AS mesh_edge_utilities

RUN apk add --no-cache libstdc++ openssl ncurses-libs

WORKDIR /app

# Copy the release from build stage
COPY --from=build /app/_build/prod/rel/mesh_edge_utilities ./

# Set environment
ENV HOME=/app
ENV MIX_ENV=prod

# Run as non-root user
RUN addgroup -S app && adduser -S app -G app
USER app

CMD ["/app/bin/mesh_edge_utilities", "start"]
