# Dockerfile for CortexIQ edge applications (homes and utilities)
# Multi-stage build for optimal image size

# Stage 1: Build
FROM hexpm/elixir:1.18.1-erlang-27.2-alpine-3.21.0 AS build

# Install build dependencies
RUN apk add --no-cache build-base git

# Set working directory
WORKDIR /app

# Install hex and rebar
RUN mix local.hex --force && \
    mix local.rebar --force

# Set build environment
ENV MIX_ENV=prod

# Copy mix files
COPY system/mix.exs system/mix.lock ./
COPY system/config config

# Copy all app mix files
COPY system/apps/cortex_iq_core/mix.exs ./apps/cortex_iq_core/
COPY system/apps/macula_os/mix.exs ./apps/macula_os/
COPY system/apps/cortex_iq_homes/mix.exs ./apps/cortex_iq_homes/
COPY system/apps/cortex_iq_utilities/mix.exs ./apps/cortex_iq_utilities/

# Get dependencies
RUN mix deps.get --only prod
RUN mix deps.compile

# Copy application code
COPY system/apps/cortex_iq_core ./apps/cortex_iq_core
COPY system/apps/macula_os ./apps/macula_os
COPY system/apps/cortex_iq_homes ./apps/cortex_iq_homes
COPY system/apps/cortex_iq_utilities ./apps/cortex_iq_utilities

# Compile the project
RUN mix compile

# Build releases
RUN mix release cortex_iq_homes
RUN mix release cortex_iq_utilities

# Stage 2: Runtime (homes)
FROM alpine:3.21.0 AS cortex_iq_homes

RUN apk add --no-cache libstdc++ openssl ncurses-libs

WORKDIR /app

# Copy the release from build stage
COPY --from=build /app/_build/prod/rel/cortex_iq_homes ./

# Set environment
ENV HOME=/app
ENV MIX_ENV=prod

# Run as non-root user
RUN addgroup -S app && adduser -S app -G app
USER app

CMD ["/app/bin/cortex_iq_homes", "start"]

# Stage 3: Runtime (utilities)
FROM alpine:3.21.0 AS cortex_iq_utilities

RUN apk add --no-cache libstdc++ openssl ncurses-libs

WORKDIR /app

# Copy the release from build stage
COPY --from=build /app/_build/prod/rel/cortex_iq_utilities ./

# Set environment
ENV HOME=/app
ENV MIX_ENV=prod

# Run as non-root user
RUN addgroup -S app && adduser -S app -G app
USER app

CMD ["/app/bin/cortex_iq_utilities", "start"]
